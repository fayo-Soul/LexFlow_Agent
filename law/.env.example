# ============================================
# 法律咨询 RAG 项目 — 环境变量模板
# 使用方式：cp .env.example .env 后修改真实值
# 注意：.env 文件不要提交到代码仓库
# ============================================

# MySQL 配置（VMware VM IP）
MYSQL_HOST=192.168.88.100
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=fzt_law
MYSQL_LAW_QA_TABLE=fzt_qa

# Redis 配置（VMware VM IP）
REDIS_HOST=192.168.88.100
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Milvus 配置（VMware VM IP）
MILVUS_HOST=192.168.88.100
MILVUS_PORT=19530
MILVUS_DATABASE_NAME=fzt_law
MILVUS_COLLECTION_NAME=fzt_legal_curated_v1

# 案例库 Milvus 配置
CASE_MILVUS_DATABASE_NAME=fzt_case
CASE_MILVUS_COLLECTION_NAME=fzt_case_hybrid

# LLM 配置
LLM_MODEL=qwen-plus
DASHSCOPE_API_KEY=change_me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 检索参数配置
PARENT_CHUNK_SIZE=512
CHILD_CHUNK_SIZE=128
CHUNK_OVERLAP=50
RETRIEVAL_K=5
CANDIDATE_M=2

# 应用配置
VALID_SOURCES=["刑法", "民法", "劳动法", "行政法", "其他法"]
LEGAL_QA_FILE=法律问答.txt
CUSTOMER_SERVICE_PHONE=13575008699

# 模型路径（相对路径相对于项目根目录，绝对路径也可）
MODEL_DIR=rag_qa/models
BERT_CLASSIFIER_DIR=rag_qa/models/bert_law_classifier
BGE_M3_DIR=rag_qa/models/bge-m3
BGE_RERANKER_DIR=rag_qa/models/bge-reranker-large

# API 安全
API_TOKEN=change_me
RESEARCHER_API_TOKEN=change_researcher_token
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=20
DOCUMENT_REGISTRY_BACKEND=mysql
INDEX_QUEUE_ENABLED=true
SESSION_SIGNING_KEY=change_to_a_random_64_character_value
ALLOW_INTERNAL_TO_EXTERNAL_LLM=false

# 日志配置
LOG_FILE=logs/app.log
