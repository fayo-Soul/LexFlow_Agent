APP_NAME=lexflow-agent
APP_VERSION=1.1.0
DEBUG=false
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_TOKEN=

# LLM - 主模型
LLM_PRIMARY_PROVIDER=deepseek
LLM_PRIMARY_MODEL=deepseek-chat
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1

# LLM - 备用模型
LLM_BACKUP_PROVIDER=openai
LLM_BACKUP_MODEL=qwen-plus
LLM_BACKUP_API_KEY=
LLM_BACKUP_BASE_URL=

# law RAG
LAW_RAG_BASE_URL=http://192.168.88.100:8001
LAW_RAG_API_KEY=

# 数据库
CHECKPOINT_DB_URL=sqlite:///./checkpoints.db
CHECKPOINT_DB_URL_PSQL=

# Redis
REDIS_URL=

# Runtime
MAX_CONCURRENT_TASKS=5
WORKFLOW_TIMEOUT_SECONDS=1800

# LangSmith (可选追踪)
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lexflow-agent
